;; listing-pace-observation.edn — bounded actor contract for observing
;; the PACE of public first-party portfolio-page listing events per fund
;; vehicle, proposed to Hyakka (network-awai/app-hyakka) as auditable
;; questions, not as a score.
;;
;; Scope guard: this contract counts LISTING EVENTS that the
;; portfolio-listing-observation.v1.1 contract already admits (same
;; entity separation, same receipt discipline, same carry-both conflict
;; rule). It is a compositional improvement: it defines NO new admissibility
;; and NO new semantics — it re-counts admitted events per window with one
;; added dimension, whether the listing event carried a date or not.
;;
;; A pace count says how many listing events were observed in a window
;; for a fund vehicle, and how many of those events could not be dated
;; from the receipt. It is NOT activity, NOT deal flow, NOT momentum and
;; NOT a performance signal (listing-pace-is-not-activity,
;;  undated-is-not-quiet, pace-is-not-performance). A fund with zero
;; observed listing events in a window is UNMEASURED-or-ZERO per receipt
;; coverage — the contract never converts absence into a statement about
;; the fund. Every count traces to admitted listing events, and each of
;; those to a source receipt by hash. The contract does not rank funds,
;; companies, GPs or LPs, does not infer ownership stakes or returns,
;; and produces no investment advice.
;;
;; Method version: v2 (2026-09-05). Any change to field semantics bumps
;; :method/version and appends a :refresh/history entry; old observations
;; are never silently reinterpreted.
;;
;; v2 hardening (v1 -> v2, no prior semantics silently changed):
;; 1. Fetch-status ADMISSION — a receipt carries an explicit fetch status
;;    (:ok, :error, :redirected, :not-modified, :robots-disallowed,
;;    :auth-required). Only :ok receipts are ADMITTED to back a pace
;;    count; every other status is recorded verbatim but refuses
;;    admission (:admission-refused-receipt-backs-no-observation) and
;;    produces a refusal record, never silence. An event whose receipt
;;    later re-fetches as :error does not retro-actively invalidate
;;    already-derived pace rows — the re-fetch is a new receipt plus a
;;    refresh-history entry, never an edit.
;; 2. Provenance-chain STRICTNESS — every pace row's :provenance-chain is
;;    the ordered receipt ids of its cited events, all existing,
;;    non-empty, first element = first cited event's :source-receipt-id.
;;    Inventing, trimming or re-heading a chain is a violation
;;    (:provenance-chain-is-required-and-verified). Carry-both conflicts
;;    keep BOTH receipts in the chain; the contract never picks a winner.
;; 3. Readback strictness — an unknown filter key is REJECTED
;;    (:rejected-filter), never silently ignored (which would quietly
;;    widen the query); an :event-kind filter matches the carried kind
;;    exactly, so a removal is never returned under a listing filter
;;    (event kinds never collapse in readback).

{:contract/id :listing-pace-observation
 :contract/version "2.0.0"
 :method/version "listing-pace-observation.v2"
 :actor :cloud-itonami/app-public-fund
 :proposes-to :network-awai/app-hyakka
 :composes-with [:portfolio-listing-observation]   ; must be v1.1 or later

 ;; ── Measurement window ─────────────────────────────────────────────
 ;; Half-open [from, until) in UTC ISO-8601 dates, identical shape to
 ;; the composed contract. "missing" inside a window means "not measured
 ;; in this window", never "nothing happened".
 :window
 {:schema [:from :until :declared-at :timezone]
  :format "YYYY-MM-DD"
  :closed? false                       ; [from, until)
  :rule :window-must-not-overlap-within-same-fund-and-method}

 ;; ── Input: admitted listing events ─────────────────────────────────
 ;; Inputs are events ALREADY admitted by portfolio-listing-observation
 ;; v1.1+, cited by event ref with a resolvable provenance chain to the
 ;; source receipt. This contract refuses events from other contracts,
 ;; other method versions, or with unresolvable chains.
 :input-listing-event
 {:schema [:event-ref :event-kind :fund-vehicle-entity-id
           :portfolio-company-entity-id :event-date-or-missing
           :source-receipt-id :source-receipt-hash
           :receipt-fetch-status :method/version]
  :event-kind-allow #{:listed-on-portfolio-page
                      :removed-from-portfolio-page}
  ;; v2 admission gate: only events backed by :ok receipts may enter a
  ;; pace count. Non-:ok receipts are recorded verbatim, produce a
  ;; refusal record, and never back an observation.
  :receipt-fetch-status-values #{:ok :error :redirected :not-modified
                                 :robots-disallowed :auth-required}
  :receipt-admission {:admitted #{:ok}
                      :refusal-record {:schema [:event-ref :receipt-id
                                                :receipt-fetch-status
                                                :refused-at
                                                :method/version]}
                      :rule :admission-refused-receipt-backs-no-observation
                      :re-fetch-rule :re-fetch-appends-new-receipt-plus-history}
  :rules #{:only-admitted-portfolio-listing-v1.1-events-refuse-otherwise
           :event-date-missing-is-a-flag-not-a-drop}
  ;; An event with no date on the receipt is counted in
  ;; :undated-count and flagged :event-date-not-stated. It is never
  ;; dropped, back-dated, or assumed to fall in the window: undated
  ;; events are counted separately and NEVER added to :dated-count.
  :date-basis :receipt-stated-date-only
  :version-separation :one-method-version-per-pace-observation}

 ;; ── Typed entity inputs ────────────────────────────────────────────
 ;; Entity separation is inherited unchanged from the composed contract:
 ;; fund vehicle, management company and portfolio company are distinct
 ;; entities even under one brand (brand-is-not-legal-entity).
 :entity-types #{:fund-vehicle :management-company :portfolio-company
                 :general-partner :jurisdiction}

 ;; ── Derived pace observation ───────────────────────────────────────
 :derived-pace-observation
 {:schema [:pace-id :method/version :window :fund-vehicle-entity-id
           :event-kind :dated-count :undated-count
           :conflict-count :missingness-flags :provenance-chain
           :asserted-at]
  :event-kinds #{:listed-on-portfolio-page :removed-from-portfolio-page}
  ;; Counts are sums over cited events, never recomputed from raw
  ;; receipts and never extrapolated across windows.
  :invariants #{:counts-are-sums-of-cited-events-not-recomputed
                :undated-events-never-added-to-dated-count
                :per-fund-per-window-per-kind-one-row
                :admission-refused-receipt-backs-no-observation}
  ;; A window with zero cited events is a row with (0, 0) plus a
  :rules #{:zero-event-window-is-a-row-not-silence
  ;; missingness flag :no-events-in-window-from-measured-sources.
  ;; Conflict propagation: events involved in a v1.1
  ;; :conflict-observation count in :conflict-count AND in their
  ;; dated/undated count, and both receipts ride the provenance chain
  ;; (carry-both, never adjudicate).
           :carry-both-conflicts-no-winner}
  ;; v2: the chain is the ordered receipt ids of the cited events —
  ;; all existing, non-empty, first element = first cited event's
  ;; :source-receipt-id. Inventing, trimming or re-heading is a
  ;; violation; conflicted events keep both receipts.
  :provenance-chain-rule
  {:non-empty? true :subset-of-receipt-ids? true
   :first-element-is-first-cited-event-receipt-id? true
   :conflict-keeps-all-competing-receipts? true}
  :flag-propagation #{:event-date-not-stated :no-receipt :receipt-unparseable
                      :no-events-in-window-from-measured-sources
                      :source-language-unmapped
                      :fetch-status-non-ok :admission-refused
                      :provenance-chain-incomplete}
  ;; Structurally excluded fields — a pace observation must not become
  ;; a leaderboard, a momentum indicator or a performance claim.
  :forbidden-fields #{:rank :score :centrality :velocity :momentum
                      :nav :ownership-stake :suitability :recommendation
                      :current-valuation :implied-deal-count
                      :data-quality-score :completeness-score}}

 ;; ── Refresh history ────────────────────────────────────────────────
 ;; Append-only. Re-running the same window + method/version with
 ;; unchanged inputs re-emits the same observation id (idempotent); a
 ;; changed input emits a NEW observation and appends a history entry
 ;; pointing at the superseded one. Superseded observations are never
 ;; deleted. A receipt that re-fetches with a different status appends
 ;; a new receipt plus a history entry — it never edits or invalidates
 ;; prior pace rows.
 :refresh-history
 {:mode :append-only
  :schema [:pace-id :re-run-at :trigger :input-digest
           :supersedes-or-nil]
  :triggers #{:window-advanced :inputs-updated :receipt-refetched
              :method-version-bumped}
  :rules #{:idempotent-rerun-same-inputs-same-id
           :changed-input-new-observation-not-rewrite
           :re-fetch-appends-never-edits}}

 ;; ── Hyakka proposal shape ──────────────────────────────────────────
 ;; Proposals are auditable QUESTIONS about measurement coverage. Never
 ;; advice, never allocation, never outreach, never fundraising.
 :hyakka-proposal
 {:kind :observation-question-set
  :max-questions-per-window 5
  :question-kinds #{:coverage :missingness :provenance}
  ;; Example shapes (questions, not assertions):
  ;;   "In window W, how many listing events for fund vehicle F carried
  ;;    a receipt-stated date?"
  ;;   "Which portfolio-listing events in W could not be dated, and
  ;;    what receipts back them?"
  ;;   "How many of F's cited receipts in W were refused admission, and
  ;;    what fetch statuses did they carry?"
  :forbidden-kinds #{:recommendation :ranking :suitability :outreach
                     :fundraising :allocation :ownership-claim
                     :performance-claim :valuation-claim}}

 ;; ── Query / readback shape ─────────────────────────────────────────
 ;; Deterministic readback: any read returns rows WITH coverage and
 ;; missingness, and refuses to return rows without them. Readback is
 ;; read-only and never computes a score on the way out.
 :query-readback
 {:request-schema [:query-id :window :filter {:keys #{:fund-vehicle
                                                      :event-kind}}]
  :shape [:query-id :pace-id :method/version :window
          :fund-vehicle-entity-id :event-kind
          :dated-count :undated-count :conflict-count
          :missingness-flags :provenance-chain :coverage-record
          :asserted-at]
  :required-with-every-row #{:coverage-record :missingness-flags
                             :provenance-chain}
  ;; v2: unknown filter keys are REJECTED, never silently ignored; an
  ;; :event-kind filter matches the carried kind exactly — a removal is
  ;; never returned under a listing filter (kinds never collapse).
  :strictness {:rule :unknown-filter-key-rejected-not-ignored
               :event-kind-filter-rule :filter-matches-carried-kind-exactly}
  :status-values #{:ok :unmeasured :out-of-window :rejected-filter
                   :admission-refused}
  :rules #{:readback-refuses-row-without-coverage-and-missingness
           :readback-is-read-only}}}
