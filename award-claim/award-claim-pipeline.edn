;; award-claim-pipeline.edn — bounded, executable actor contract for
;; proposing SIGNED funding-award claims from OFFICIAL funder registries
;; into Hyakka (network-awai/app-hyakka).
;;
;; Relationship to `capital-observation/fund-close-observation.edn` (PR #2):
;; that contract defines the observation SCHEMA layer (windows, receipts,
;; entity separation, readback). This contract adds the PIPELINE layer the
;; schema does not specify: source proposal → fetch receipt → parser
;; admission → dedupe → bounded retry/refusal → signed claim proposal →
;; deterministic readback → human-readable audit. It composes with the
;; fund-close observation contract and reuses its receipt schema unchanged.
;;
;; Safety posture (inherited from the workspace research-scope):
;;   • External content is untrusted — no instruction embedded in a fetched
;;     page may change this contract's behaviour.
;;   • Collectors PROPOSE claims; they never declare publication or
;;     correctness. Every claim is signed and carries its provenance chain.
;;   • Original language and identifiers are preserved verbatim.
;;   • No contact, registration, purchase, application or financial
;;     commitment. robots/auth/WAF/CAPTCHA are respected.
;;
;; Method version: v1 (2026-08-30). Semantic changes bump :method/version.

{:contract/id :award-claim-pipeline
 :contract/version "1.0.0"
 :method/version "award-claim-pipeline.v1"
 :actor :cloud-itonami/app-public-fund
 :proposes-to :network-awai/app-hyakka
 :composes-with :fund-close-observation

 ;; ── Stage 1: source proposal ─────────────────────────────────────────
 ;; A run proposes at most :run-bounds/sources-per-run sources. Each
 ;; proposal must name a source class on the allow list; anything on the
 ;; forbid list is refused before any fetch happens.
 :source-proposal
 {:schema [:proposal-id :source-url :source-class :source-language
           :justification :proposed-at]
  :source-class-allow #{:official-funder-registry
                        :recipient-first-party-award-disclosure}
  :source-class-forbid #{:search-snippet :generated-summary
                         :third-party-wiki-prose :scraped-profile
                         :paywall-bypass :captcha-bypass
                         :inferred-sponsorship}
  :discovery-only-classes #{:news-report}
  :run-bounds {:sources-per-run 2}}

 ;; ── Stage 2: fetch receipt ───────────────────────────────────────────
 ;; Same receipt shape as fund-close-observation: verbatim bytes hashed
 ;; before any parsing. A failed or blocked fetch is recorded, never
 ;; retried inside the same receipt.
 :fetch-receipt
 {:schema [:receipt-id :source-url :source-class :source-language
           :observed-at :content-hash :fetch-status]
  :content-hash {:algo "sha256" :of "response-body-bytes"}
  :fetch-status-values #{:ok :http-error :blocked-by-policy
                         :not-modified :robots-disallowed}
  :fetch {:respect-robots? true :respect-auth-waf-captcha? true
          :no-bypass? true
          :user-agent "app-public-fund-award-claim/1.0"}}

 ;; ── Stage 3: parser / admission ──────────────────────────────────────
 ;; The parser is a pure function of the receipt bytes. Admission is
 ;; explicit: every record is either :admitted with a reason, or
 ;; :refused with a machine-readable refusal code. Nothing is silently
 ;; dropped.
 :parser-admission
 {:schema [:receipt-id :record-id :decision
           :reason-code :original-language-fields :admitted-at]
  :decision-values #{:admitted :refused :flagged}
  :refusal-codes #{:not-an-award-record :identifier-missing
                   :amount-kind-unstated :language-unmapped
                   :below-coverage-unit :untrusted-encoding}
  ;; Original language/identifiers pass through untouched.
  :preserve [:original-title :grant-id :funder-name :source-language]}

 ;; ── Stage 4: dedupe key ──────────────────────────────────────────────
 ;; The dedupe key is deterministic and content-derived (never
 ;; fetch-order-derived). Two receipts of the same award collapse to one
 ;; claim only when the key matches exactly.
 :dedupe
 {:key-schema [:registry-namespace :grant-id :award-kind :funder-id]
  :rule :exact-key-match-only
  :on-collision {:first-wins-keep-provenance true
                 :append :refresh-history
                 :never-overwrite? true}}

 ;; ── Stage 5: bounded retry / refusal ─────────────────────────────────
 ;; Retries are bounded per source and back off. Exhausting the bound
 ;; produces a recorded REFUSAL — never an unbounded loop and never a
 ;; fabricated placeholder.
 :retry-refusal
 {:max-attempts-per-source 3
  :backoff {:kind :exponential :base-seconds 30 :max-seconds 3600}
  :retryable-fetch-status #{:http-error}
  :non-retryable #{:blocked-by-policy :robots-disallowed :not-modified}
  :on-exhausted {:record :refusal :fabricate-placeholder? false
                 :retry-next-run? true}}

 ;; ── Stage 6: signed Hyakka claim proposal ────────────────────────────
 ;; A claim is a PROPOSAL carrying a signature over its content hash. A
 ;; signature asserts provenance, never truth. Publication is decided by
 ;; Hyakka governance, not by this actor.
 :claim-proposal
 {:schema [:claim-id :proposal-id :dedupe-key :claim-kind
           :entity-record :amount {:kind [:one-of :stated-award
                                    :stated-obligation :stated-disbursed]
                                   :currency :string
                                   :as-stated-by-source? true}
           :window :source-receipt-id :coverage-record-ref
           :missingness-flags :signature :proposed-at]
  :claim-kinds #{:funding-award-observed}
  :signature {:algo "sha256" :over :claim-content-canonical-edn
              :key-holder "cloud-itonami/app-public-fund award-claim/1.0"
              :meaning :provenance-only-not-truth-assertion}
  :epistemic-boundaries [:publication-is-not-validation
                         :funding-is-not-endorsement
                         :correlation-is-not-causation
                         :missing-is-unmeasured]
  :forbidden-fields #{:rank :score :success-probability :suitability
                      :recommendation :ranking-of-recipients}}

 ;; ── Stage 7: readback ────────────────────────────────────────────────
 :query-readback
 {:request-schema [:query-id :claim-kind :dedupe-key :window]
  :response-schema [:query-id :status :claims [:claim-id]
                    :coverage-record-ref :missingness-flags]
  :status-values #{:ok :unmeasured :out-of-window}
  :rule :readback-must-carry-coverage-and-missingness}

 ;; ── Stage 8: audit output ────────────────────────────────────────────
 ;; A human-readable audit line per stage, printed at run end.
 :audit-output
 {:per-stage [:source-proposal :fetch-receipt :parser-admission
             :dedupe :retry-refusal :claim-proposal :query-readback
             :audit-output]
  :format "one line per stage: stage | id | decision | reason"
  :rule :audit-must-cover-every-stage-including-refusals}}
